#!/bin/env python3

"""CLI to control CAX mirror motors for scanning its mirror."""

from datetime import datetime
import os
import re
import matplotlib.pyplot as plt
import numpy as np
import argparse

from caxscripts import utils
from caxscripts.h5file import HDF5File
from siriuspy.devices import CAXCtrl
import caxscripts.motormov as mtv
# import sys


# Scan types:
# key = user choice;
# list : menu description, PV name, device name, class name.
SCAN_TYPES = {
    '1' : ['Mirror x translation (Tx)',         'cs_tx',    'mirror',
           'CAXMirrorMove'],
    '2' : ['Mirror x rotation    (Rx)',         'cs_rx',    'mirror',
           'CAXMirrorMove'],
    '3' : ['Mirror y translation (Ty)',         'cs_ty',    'mirror',
           'CAXMirrorMove'],
    '4' : ['Mirror y rotation    (Ry)',         'cs_ry',    'mirror',
           'CAXMirrorMove'],
    '5' : ['Mirror z rotation    (Rz)',         'cs_rz',    'mirror',
           'CAXMirrorMove'],
    '6' : ['Caustic',                           'z_pos',    'dvf_B1',
           'CAXCausticMove'],
    '7' : ['Lens (DVF2) translation',           'lens_pos', 'lens',
           'CAXLensMove'],
    '8' : ['Slit set 1 window (before mirror)', 'slit_A1',  'slit_A1',
           'CAXSlitMove'],
    '9' : ['Slit set 2 window (after mirror)',  'slit_B1',  'slit_B1',
           'CAXSlitMove'],
}


# The WSIZE_H/V values are used to convert pixel intervals observed by the DVF
# into actual motor positions. They are determined by the geometry of the
# YAG. Adjust these values if there are changes in the setup or calibration.
WSIZE_V, WSIZE_H = 467, 178


def scan_menu_select() -> tuple[list[str], str]:
    """Select scan type from a menu."""
    print("\nSelect scan (type a list of numbers separated by spaces):\n")
    for key, value in SCAN_TYPES.items():
        print(f"  {key} - {value[0]} scan")

    scantype = list()
    choices  = input("\n Enter choice [1-9], 'q' to quit: ")

    # Quit
    if choices.lower() == 'q':
        print("Exiting... Done.")
        exit(0)

    if choices.lower() == '':
        print("No choices entered. Please enter at least one choice.")
        return scan_menu_select()  # Restart menu selection

    # Validate choices and create corresponding device move instances.
    choices = choices.strip().split()
    for choice in choices:
        try:
            if choice not in SCAN_TYPES:
                raise ValueError("Invalid choice")
            # Keep the menu key — mapped to PV name in the main loop.
            scantype.append(choice)
        except Exception as err:
            print(f"{err} -- '{choice}' "
                " Please enter a number between 1 and 9.")
            scan_menu_select()  # Restart menu selection

    print("\n### Selected scan types:"
          f" {', '.join(SCAN_TYPES[ch][0] for ch in scantype)}\n")

    # File to record data.
    filename = input(
        " Enter filename base to save results"
        " (timestamp will be included)): ")
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"{filename}-{timestamp}.hdf5"

    return scantype, filename


def device_picker(
        choice: str,
        cax: "CAXCtrl"
        ):
    """Return the device instance for the chosen scan type."""
    class_name = SCAN_TYPES[choice][3]
    return getattr(mtv, class_name)(cax)


def status_show(cax: "CAXCtrl") -> dict:
    """Show current status of the device."""
    # Get current status of all devices.
    cax_status = utils.snapshot_machine_state(cax)

    # Run through all devices and print their status.
    for key, val in cax_status.items():
        print(f" -- {key.replace('_', ' ').upper()}:\n")
        for pv, vs in val.items():
            try:
                if isinstance(vs, (int, float)):
                    if vs < 1e-3:
                        print(f"    * {pv:30} : {vs:1.4e}")
                    else:
                        print(f"    * {pv:30} : {vs:10.4f}")
                    continue
                elif pv == 'image':
                    print(f"    * {pv:15} : [image data, shape = {vs.shape}]")
                else:
                    curr = float(vs[0])
                    lolm = float(vs[1])
                    hilm = float(vs[2])
                    enbl = True if vs[3] == 1 else False
                    print(f"    * {pv:15} :"
                        f" {curr:10.4f},\t"
                        f" limits = [{lolm:10.4f}, {hilm:10.4f}], \t"
                        f" Enabled: {enbl}")

                # print(f"  * {pv:12} : ", end="")
                # enbl = True if vs[1] == 1 else False
                # print(f"{vs[0]:12.6f}, enabled = {enbl}")
            except Exception as err:
                print(f" WARNING (status show) : {err} ({key}/{pv})")
                # for bl, v in val.items():
                #     print(f"  * {bl:15} : {v}")
        print("\n")
    print("\n#####\n")

    return cax_status


def _ask_val(
        prompt: str,
        limits: tuple[float, float]
        ) -> float:
    while True:
        raw = input(prompt).strip()
        if raw.lower() == 'q':
            print("Exiting... Done.")
            exit(0)
        try:
            value = float(raw)
        except ValueError as err:
            print(f" WARNING (_ask_val) :\n {err}")
            print("Invalid input. Please enter a numeric value.\n")
            continue
        if not _within_limits(value, limits):
            print(f"Value must be within limits: {limits}\n")
            continue
        return value


def _general_parameters_ask(
        motortype: str,
        limits: tuple[float, float]
        ) -> dict:
    """Ask a question with multiple options and return the selected option."""
    scanargs = dict()
    scanargs['start']  = _ask_val(
        f"Enter start {motortype} position/angle: ", limits
        )
    scanargs['stop']   = _ask_val(
        f"Enter stop {motortype} position/angle: ", limits
        )
    scanargs['nsteps'] = int(_ask_val(
        "Enter number of steps for scanning: ", limits=(1, float('inf'))
        ))
    scanargs['nsnapshots']  = int(_ask_val(
        "Enter number of snapshots per step: ", limits=(1, float('inf'))
        ))
    scanargs['dtime']  = float(_ask_val(
        "Enter dwell time for each snapshot (s): ", limits=(0, float('inf'))
        ))
    return scanargs


# The methods below convert pixel intervals observed by the DVF
# into actual motor positions.
def _top_pos_from_pixels(pixel: float) -> float:
    return -pixel * 0.01039 + 19.1


def _bottom_pos_from_pixels(pixel: float) -> float:
    return (pixel - WSIZE_V) * 0.01041 + 37.4


def _left_pos_from_pixels(pixel: float) -> float:
    return -pixel * 0.007126 + 44.3


def _right_pos_from_pixels(pixel: float) -> float:
    return (pixel - WSIZE_H) * 0.007126 + 46.4


def slit_parameters_ask(scantype: str, cax_status: dict, cax: CAXCtrl):
    """Get scan parameters from user."""
    motortype = SCAN_TYPES[scantype][1]
    devname   = SCAN_TYPES[scantype][2]
    device_mv = device_picker(scantype, cax)
    print(f"###\n###  {motortype} scan parameters\n###\n")

    # Open slits and show slit boundary image for reference.
    slit_status = utils.slit_open(device_mv, cax_status)
    img = utils.snapshot_dvf(cax.dvf_A1, include_imgproc=False)['image']
    top, bottom, left, right = utils.image_show_slit_boundary(img)

    # Get relevant parameters for the slit device.
    currval = {
        key : float(val[0])
        for key, val in cax_status[devname].items()
        }
    print(f" ** Current {motortype} value:")
    for key, val in currval.items():
        print(f"  - {key}: {val:10.4f}")

    for slit, vals in cax_status[devname].items():
        limits = (min(vals[1], vals[2]),
                  max(vals[1], vals[2]))
        print(f"\n ** {slit} slit limits:"
              f"   [{limits[0]:10.4f}, {limits[1]:10.4f}]")

    hsize = np.abs(right - left)
    vsize = np.abs(top - bottom)
    print("\n * Current window size: "
          f"{hsize:10.4f} pixels x {vsize:10.4f} pixels")
    # pixel_size = 0.48e-3  # mm per pixel

    scanargs = dict()
    scanargs['slit'] = devname
    scanargs['slit_initial_status'] = slit_status
    question = (" > Enter number of horizontal steps for scanning"
                " (max = number of pixels in horizontal direction): ")
    n_h_windows = int(_ask_val(question, limits=(1, hsize)))

    question = (" > Enter number of vertical steps for scanning"
                " (max = number of pixels in vertical direction): ")
    n_v_windows = int(_ask_val(question, limits=(1, vsize)))
    scanargs['nsteps'] = (n_h_windows, n_v_windows)

    question = (" > Superposition between windows, in %"
                "(0 for no superposition): ")
    superp = float(_ask_val(question, limits=(0, 100))) / 100.0

    win_x = (hsize / n_h_windows) * (1 + superp)
    xcenter_pos_pixels = np.array([
        win_x * (0.5 + i * (1 - superp)) for i in range(n_h_windows)
        ])
    scanargs['left_pos']  = _left_pos_from_pixels(
        xcenter_pos_pixels - win_x / 2
        )
    scanargs['right_pos'] = _right_pos_from_pixels(
        xcenter_pos_pixels + win_x / 2
        )

    win_y = (vsize / n_v_windows) * (1 + superp)
    ycenter_pos_pixels = np.array([
        win_y * (0.5 + i * (1 - superp)) for i in range(n_v_windows)
        ])
    scanargs['bottom_pos'] = _bottom_pos_from_pixels(
        ycenter_pos_pixels + win_y / 2
        )
    scanargs['top_pos']    = _top_pos_from_pixels(
        ycenter_pos_pixels - win_y / 2
        )
    #
    scanargs['winsize'] = (win_x, win_y)

    return device_mv, scanargs


def _within_limits(value: float, limits: tuple[float, float]) -> bool:
    return limits[0] <= value <= limits[1]


def _motor_limits(scantype: str, cax_status: dict) -> tuple[float, float]:
    """Motor limits for a scan type, read from the machine status."""
    motortype   = SCAN_TYPES[scantype][1]
    device      = SCAN_TYPES[scantype][2]
    motorstatus = cax_status[device].get(motortype)
    if motorstatus is None:
        # Slit scans have no single motor; see note below.
        return (-np.inf, np.inf)
    return (min(motorstatus[1], motorstatus[2]),
            max(motorstatus[1], motorstatus[2]))


def _parameter_limits(scantype: str, cax_status: dict) -> dict:
    """Per-parameter limits shared by interactive and file parsing."""
    motor_limits = _motor_limits(scantype, cax_status)
    return {
        'start'      : motor_limits,
        'stop'       : motor_limits,
        'nsteps'     : (1, float('inf')),
        'nsnapshots' : (1, float('inf')),
        'dtime'      : (0, float('inf')),
        }


def parameters_ask(scantype: str, cax_status: dict):
    """Get scan parameters from user."""
    motortype   = SCAN_TYPES[scantype][1]
    device      = SCAN_TYPES[scantype][2]
    print(f"###\n###  {motortype} scan parameters\n###\n")

    # Other cases.
    motorstatus = cax_status[device][motortype]
    currval = float(motorstatus[0])
    print(f" ** Current {motortype} value: {currval:10.4f}")

    # Guarantees the order of limits for later comparison.
    limits = _motor_limits(scantype, cax_status)
    print(f" ** Parameter limits:   [{limits[0]:10.4f}, {limits[1]:10.4f}]")
    return _general_parameters_ask(motortype, limits)


def show_results(results, scantype: str):
    """Show scan results."""
    print("\n\n##### Scan Results #####\n")
    fig, ax = plt.subplots()
    ax.plot(results['position'], results['intensity'], marker='o')
    ax.set_xlabel('Position/Angle (urad)')
    ax.set_ylabel('Intensity (a.u.)')
    dt = SCAN_TYPES[scantype]
    ax.set_title(f'CAX {dt} Scan Results')
    plt.grid()
    plt.show()


def _parse_scantype(val: str) -> str:
    if val not in SCAN_TYPES:
        print(f" ERROR (read_parameter_file): Unknown scan type: {val}\n Stopping.")
        exit(1)
    return val


def _parse_outputfile(prefix: str) -> str:
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"{prefix}-{timestamp}.hdf5"
    return filename


_PARAM_PARSERS = {
    'scantype'   : _parse_scantype,
    'outputfile' : _parse_outputfile,
    'start'      : float,
    'stop'       : float,
    'nsteps'     : int,
    'nsnapshots' : int,
    'dtime'      : float,
}


def read_parameter_file(
        filename   : str,
        cax_status : dict,
        ) -> dict:
    """Read scan parameters from file."""
    if not os.path.isfile(filename):
        print(f" ERROR (read_parameter_file) : File not found: {filename}")
        exit(1)

    scanargs = {
        'scantype'   : '',
        'outputfile' : '',
        'start'      : 1.0,
        'stop'       : 1.0,
        'nsteps'     : 10,
        'nsnapshots' : 1,
        'dtime'      : 1.0,
        }

    with open(filename, 'r') as fn:
        for line in fn:
            # Skip empty lines and comments.
            if not line.strip() or re.match(r'^\s*#', line):
                continue

            key, val = line.strip().split()

            if key not in scanargs.keys():
                print(" WARNING (read_parameter_file):"
                    f" Unknown parameter {key}.\n Stopping.")
                exit(1)

            scanargs[key] = _PARAM_PARSERS[key](val)

    # To be implemented: define the limits for the scan parameters.
    limits = _parameter_limits(scanargs['scantype'], cax_status)
    for key in ('start', 'stop', 'nsteps', 'nsnapshots', 'dtime'):
        if not _within_limits(scanargs[key], limits[key]):
            print(f" ERROR (read_parameter_file): {key} = {scanargs[key]}"
                  f" outside limits {limits[key]}\n Stopping.")
            exit(1)

    return scanargs


def cmd_line() -> "argparse.Namespace":
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(description="Carcará Mirror Scan CLI")
    parser.add_argument(
        "--paramfile", "-p", type=str, required=False,
        help="Text file containing scan parameters."
    )
    parser.add_argument(
        "--return-to-initial", action="store_true",
        help="Return device to initial position after scan."
    )
    return parser.parse_args()


def main() -> None:
    """Main function to run the CLI."""
    # Current status.
    print("#####\n##### Carcará Scanning System\n#####\n")

    # Read command-line arguments.
    args = cmd_line()

    # Initialize control.
    cax = CAXCtrl()

    # Show status of devices.
    print("\n##### Current Status of Selected Devices\n")
    cax_status = status_show(cax)

    # Select scan type.
    fileargs = None
    if args.paramfile is None:
        scantypes, filename = scan_menu_select()
    else:
        # Read scan parameters from the provided parameter file.
        fileargs  = read_parameter_file(args.paramfile, cax_status)
        scantypes = [fileargs['scantype']]
        filename  = fileargs['outputfile']

    # Open HDF5 file for per-step saving.
    h5file = HDF5File(filename, filedir='.')

    print("\n##### Starting {} scan #####\n".format(
        ", ".join(SCAN_TYPES[st][0] for st in scantypes)
    ))
    for choice in scantypes:
        st = SCAN_TYPES[choice][2]

        # Ask slit parameters, which has multiple parameters per slit.
        if st == 'slit_A1' or st == 'slit_B1':
            dev, scanargs = slit_parameters_ask(choice, cax_status, cax)
        else:
            # Use the parameter file if given; otherwise ask interactively.
            scanargs  = (parameters_ask(choice, cax_status)
                        if fileargs is None else fileargs)
            print(
                f"\n### Starting {SCAN_TYPES[choice]} scan with parameters:\n"
                f" start    : {scanargs['start']:15.4f} mm,\n"
                f" stop     : {scanargs['stop']:15.4f} mm,\n"
                f" in       : {scanargs['nsteps']:15} steps,\n"
                f" interval : {scanargs['dtime']:15.4f} s\n"
                )

            # Instantiate the device for the chosen scan type.
            dev = device_picker(choice, cax)

        # Mirror scans need the motor attribute name.
        scanargs['motor'] = SCAN_TYPES[choice][1]

        # Run the scan for the device with the specified parameters.
        # Results can be accessed by dev.results after the scan.
        dev.device_scan(
            scanargs,
            h5file=h5file,
            do_return_to_initial=args.return_to_initial
            )

    print(f"\nData saved to {filename}.")


if __name__ == "__main__":
    """."""
    main()
